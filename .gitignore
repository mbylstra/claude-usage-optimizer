node_modules/
dist/
dist-storybook/
*.zip
.DS_Store
*.log
.vite/

# Your own work queue. Tracking it meant a "chore(queue)" commit every time a
# run rewrote a STATUS line. Start from prompts.example.txt.
prompts.txt

# The morning-after digests, one per day. Untracked for the same reasons as the
# queue they describe: personal task content, rewritten by every run.
summaries/

# The native host imports a sibling module, so Chrome leaves bytecode here
backend/__pycache__/
backend/tests/__pycache__/

# The private uv the scheduler runs, reproduced by `just install-private-uv`
backend/bin/

# Runtime snapshot and settings mirror written by the native-messaging host
backend/claude-usage.json
backend/autonomous-work-settings.json
backend/autonomous-work.jsonl
backend/autonomous-run-events.jsonl
# The pending resume a run scheduled for itself, per-machine and per-night
backend/autonomous-work-resume.json

# The Jira API token, mode 0600. Never tracked, and never mirrored through the
# settings file the host rewrites — see plans/work-queue-as-a-jira-board.md §5.3
backend/jira-credentials.json
# What the daily credential probe found, and outcomes a run could not write
backend/jira-status.json
backend/jira-pending-writes.jsonl
