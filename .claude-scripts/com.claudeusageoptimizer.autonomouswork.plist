<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. `autonomous_work_settings.py` expands the placeholders below and
  copies the result into ~/Library/LaunchAgents — from `just
  install-autonomous-work`, and again whenever the extension's settings screen
  changes the scheduled time. Do not edit the installed copy; edit this one and
  re-run the recipe.

  The hour and minute placeholders below come from
  .claude-scripts/autonomous-work-settings.json, which the extension writes
  through the native-messaging host. They default to 2 AM.

  Every placeholder here is substituted textually, so do not name one in prose.

  PATH matters more than anything else here: launchd starts jobs with a bare
  environment, and both `uv` and `claude` install under the home directory
  rather than on the default path. A missing PATH entry shows up as
  "command not found" in system.log and nothing else.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.claudeusageoptimizer.autonomouswork</string>

  <!-- A named wrapper rather than /usr/bin/env, so listings show
       "claude-usage-autonomous-work" instead of "env". -->
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/.claude-scripts/claude-usage-autonomous-work</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>__HOUR__</integer>
    <key>Minute</key>
    <integer>__MINUTE__</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/.claude-scripts/system.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/.claude-scripts/system.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
