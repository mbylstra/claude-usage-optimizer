#!/bin/bash
# Wrapper whose only job is to be well named.
#
# launchd shows whatever sits at ProgramArguments[0], so pointing the job
# straight at `/usr/bin/env` made it appear as "env" in process listings and in
# System Settings — uninformative, and indistinguishable from every other job
# that does the same thing. Naming this file after the work it does means the
# entry identifies itself.
#
# Prefers `bin/uv`, this project's own frozen copy, so any folder permission
# macOS attaches to the binary running the job stays put when the uv on PATH is
# upgraded. `just install-private-uv` puts it there and never replaces it; see
# CLAUDE.md, "Protected folders". Falling back to PATH keeps a fresh clone
# working, and the plist sets PATH explicitly because launchd starts jobs with a
# bare environment.
set -euo pipefail

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

uv_executable="$script_directory/bin/claude-usage-optimizer-uv"
[ -x "$uv_executable" ] || uv_executable="uv"

exec "$uv_executable" run --script "$script_directory/run-autonomous-work.py" "$@"
